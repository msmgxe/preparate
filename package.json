{
  "name": "rumbo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:setup": "dotenv -e .env.local -- tsx scripts/db.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/db.ts --seed",
    "check:sql": "tsx scripts/check-sql.ts",
    "db:i18n": "dotenv -e .env.local -- tsx scripts/i18n.ts",
    "db:bank": "dotenv -e .env.local -- tsx scripts/fill-bank.ts",
    "db:seed-bank": "dotenv -e .env.local -- tsx scripts/seed-bank.ts",
    "db:fix-visuals": "dotenv -e .env.local -- tsx scripts/fix-visuals.ts",
    "db:seed-audio": "dotenv -e .env.local -- tsx scripts/seed-audio.ts",
    "db:seed-lessons": "dotenv -e .env.local -- tsx scripts/seed-lessons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@neondatabase/auth": "^0.4.2-beta",
    "@neondatabase/auth-ui": "^0.2.1-beta",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
