# ─────────────────────────────────────────────────────────────────────────────
# RUMBO · variables de entorno
# Copia este archivo a .env.local (ya está en .gitignore) y complétalo.
# Nada de aquí lleva el prefijo NEXT_PUBLIC_ salvo lo que deba viajar al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres — cadena de conexión con pooling.
# Vercel la inyecta sola si instalas la integración de Neon en el Marketplace.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/rumbo?sslmode=require"

# Neon Auth — pestaña Auth del proyecto en la consola de Neon.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.sa-east-1.aws.neon.tech"

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres.
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Correos que entran como administrador la primera vez que inician sesión.
# Separados por coma. Todo lo demás entra como alumno.
ADMIN_EMAILS="msmgxe@gmail.com"

# Claude API — solo para /api/generate (borradores del balotario). Opcional.
ANTHROPIC_API_KEY=""

# URL pública del sitio, para el retorno del enlace mágico.
# En Vercel se deduce sola; en local déjala así.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
